generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  // Null until the invited user accepts their invite and sets a password.
  hashedPassword String?
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inviteTokens InviteToken[]
}

model InviteToken {
  id String @id @default(cuid())
  // SHA-256 of the raw token; the raw value only ever lives in the emailed link.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
