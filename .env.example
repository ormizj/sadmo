# Copy to .env and fill in. `.env*` is gitignored.

# --- Database (Prisma / Postgres) ---
# Matches the `db` service in compose.yaml for Docker; use localhost for a local Postgres.
DATABASE_URL="postgresql://sadmo:sadmo@localhost:5432/sadmo?schema=public"

# --- Sessions ---
# Secret for signing the JWT session cookie. Generate: `openssl rand -base64 48`
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- App ---
# Base URL used to build absolute invite links.
APP_URL="http://localhost:3000"

# --- SMTP (nodemailer) ---
# Dev tip: use a Mailtrap sandbox inbox so nothing reaches real people.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Sadmo <no-reply@sadmo.local>"

# --- Bootstrap admin (consumed by `npm run db:seed`) ---
ADMIN_EMAIL="admin@sadmo.local"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"
